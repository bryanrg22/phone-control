{
  "name": "phone-control",
  "version": "0.2.0",
  "private": true,
  "description": "Ask Claude to do something on your iPhone. A self-hosted MCP connector that drives a real, un-tethered iPhone from a small Linux server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "phonectl": "server/bin/phonectl.mjs"
  },
  "scripts": {
    "start": "node server/src/server.mjs",
    "test": "node --test \"server/test/*.test.mjs\" \"agent/test/*.test.mjs\" \"evals/phone-agent/test/*.test.mjs\" \"evals/connector/test/*.test.mjs\" \"evals/lib/test/*.test.mjs\" \"scripts/test/*.test.mjs\"",
    "test:lifecycle": "node device/test/lifecycle.test.mjs",
    "test:e2e": "node e2e/simulated.test.mjs",
    "test:all": "npm test && npm run test:lifecycle && npm run test:e2e && npm run test:conformance",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:deployed": "node scripts/check-deployed.mjs",
    "test:conformance": "node e2e/conformance.mjs",
    "snapshots:update": "UPDATE_SNAPSHOTS=1 node server/test/tool-snapshots.test.mjs",
    "evals:connector": "node evals/connector/run.mjs",
    "evals:connector:matrix": "node evals/connector/matrix.mjs",
    "test:evals:self": "node evals/connector/run.mjs --assistant oracle --expect all-pass && node evals/connector/run.mjs --assistant null --expect all-fail",
    "test:record": "node scripts/record-tests.mjs",
    "evals:phone-agent": "node evals/phone-agent/run.mjs",
    "test:tools:sim": "node e2e/tools-on-simulator.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^14.0.0",
    "openai": "^7.34.0",
    "zod": "^4.6.7"
  }
}
