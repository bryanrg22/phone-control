# /etc/phone-control/phone-control.env — settings for deploy/phone-control.service.
# Nothing in this file is secret. API keys go in /etc/phone-control/keys.env.

# ── how assistants reach this server ─────────────────────────────────────────
# The HTTPS address Tailscale Funnel gives this machine (`tailscale funnel status`).
# It must be on port 443: Claude's servers do not connect to any other port.
CONNECTOR_PUBLIC_URL=https://your-server.your-tailnet.ts.net
# Funnel terminates TLS and forwards to this loopback port over plain HTTP.
CONNECTOR_BIND=127.0.0.1
CONNECTOR_PORT=8788
CONNECTOR_ALLOW_HTTP=1

# ── the phone ────────────────────────────────────────────────────────────────
# The runner's bundle id, as printed by runner/build.sh. Required.
RUNNER_BUNDLE=com.example.you.maestro-driver-iosUITests.xctrunner
# Python 3.13+ with deploy/requirements.txt installed.
TUNNEL_PYTHON=/opt/phone-control/.venv/bin/python
# pymobiledevice3 finds the pairing record under $HOME/.pymobiledevice3.
HOME=/root

# ── tasks ────────────────────────────────────────────────────────────────────
# Which model drives the phone when a task does not name one, and until the
# person changes their default from the chat. See server/src/models.mjs.
CONNECTOR_DEFAULT_MODEL=gpt-6-luna
# The app brought back to the front when a task ends.
CONNECTOR_RETURN_APP=com.anthropic.claude

# ── where things are kept ────────────────────────────────────────────────────
# Task logs, tunnel and session logs, what the agent was asked to remember.
PHONE_CONTROL_STATE_DIR=/var/lib/phone-control
# Registered phones and assistant credentials default to /etc/phone-control/
# (devices.json, connector.json, prefs.json). Managed with `phonectl`.
