# /etc/phone-control/keys.env — chmod 600, owned by root. Never commit a real one.
# Only the provider of the model you use needs a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# The "Jev" hybrid needs TypeSafe's key as well as OPENAI_API_KEY; "Decisions"
# needs OPENAI_API_KEY only.
TYPESAFE_API_KEY=
