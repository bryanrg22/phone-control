diff --git a/ios/installationproxy/installationproxy.go b/ios/installationproxy/installationproxy.go
index 9feac66..eb698ca 100644
--- a/ios/installationproxy/installationproxy.go
+++ b/ios/installationproxy/installationproxy.go
@@ -47,7 +47,20 @@ func (c *Connection) Close() {
 }
 
 func New(device ios.DeviceEntry) (*Connection, error) {
-	deviceConn, err := ios.ConnectToService(device, serviceName)
+	// Cable-out fix: when the device is reachable over an RSD tunnel (USB out),
+	// connect through the tunnel instead of lockdown/usbmux. Installation proxy
+	// speaks plist over a raw connection, so use the raw tunnel variant (not the
+	// XPC one). Cable-in devices without a tunnel are unaffected.
+	var deviceConn ios.DeviceConnectionInterface
+	var err error
+	if device.SupportsRsd() {
+		// The tunnel exposes installation_proxy as a *.shim.remote service
+		// (rsd_test.go), and shim services require the RSDCheckin handshake —
+		// ConnectToShimService performs it; ConnectToServiceTunnelIface does not.
+		deviceConn, err = ios.ConnectToShimService(device, serviceName)
+	} else {
+		deviceConn, err = ios.ConnectToService(device, serviceName)
+	}
 	if err != nil {
 		return &Connection{}, err
 	}
diff --git a/ios/rsd.go b/ios/rsd.go
index 82f83ff..4fb1696 100644
--- a/ios/rsd.go
+++ b/ios/rsd.go
@@ -153,6 +153,14 @@ func (r RsdHandshakeResponse) GetPort(service string) int {
 	if s, ok := r.Services[service]; ok {
 		return int(s.Port)
 	}
+	// Cable-out fix: many lockdown services are exposed over the tunnel only as
+	// "<name>.shim.remote" (e.g. com.apple.mobile.installation_proxy). The JSON
+	// provider (RsdPortProviderJson.GetPort) already falls back to the shim name;
+	// the live-handshake provider must too, or every shim-only service resolves
+	// to port 0 and the dial fails with "can't assign requested address".
+	if s, ok := r.Services[service+".shim.remote"]; ok {
+		return int(s.Port)
+	}
 	return 0
 }
 
